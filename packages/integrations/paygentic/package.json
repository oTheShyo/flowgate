{
  "name": "@flowgate/paygentic",
  "version": "1.1.1",
  "description": "Optional Paygentic billing integration for flowgate (usage events, customer/subscription helpers)",
  "author": {
    "name": "flowgate maintainers",
    "email": "hello@flowgate.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oTheShyo/flowgate.git",
    "directory": "packages/integrations/paygentic"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepack": "pnpm -w --filter @flowgate/core build && npm run build"
  },
  "keywords": [
    "flowgate",
    "paygentic",
    "billing",
    "metering",
    "usage-events"
  ],
  "dependencies": {
    "@flowgate/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
